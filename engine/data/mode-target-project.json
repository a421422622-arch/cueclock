              "args": {
                "场景号": "12"
              }
            }
          ]
        },
        {
          "id": "weekend-video",
          "name": "投影播放",
          "time": "10:00:00.000",
          "enabled": false,
          "defaultTarget": "VIDEO",
          "actions": [
            {
              "id": "weekend-a2",
              "type": "udp",
              "targets": [
                "VIDEO"
              ],
              "format": "ascii",
              "payload": "PLAY",
              "offsetMs": 250
            }
          ]
        },
        {
          "id": "weekend-audio",
          "name": "音响播放",
          "time": "10:00:00.000",
          "enabled": false,
          "defaultTarget": "AUDIO",
          "actions": [
            {
              "id": "weekend-a3",
              "type": "udp",
              "targets": [
                "AUDIO"
              ],
              "format": "ascii",
              "payload": "BGM ON"
            }
          ]
        },
        {
          "id": "weekend-all",
          "name": "闭馆联动",
          "time": "18:00:00.000",
          "enabled": false,
          "actions": [
            {
              "id": "weekend-a4",
              "type": "command",
              "commandId": "cmd-off"
            }
          ]
        }
      ]
    },
    {
      "id": "holiday",
      "name": "节假日模式",
      "color": "#bf5af2",
      "groupId": "MODES",
      "priority": 10,
      "rule": {
        "dayKinds": [
          "holiday"
        ]
      },
      "cues": [
        {
          "id": "holiday-light",
          "name": "灯光开场",
          "time": "09:00:00.000",
          "enabled": false,
          "defaultTarget": "LIGHT",
          "actions": [
            {
              "id": "holiday-a1",
              "type": "command",
              "commandId": "cmd-light",
              "args": {
                "场景号": "12"
              }
            }
          ]
        },
        {
          "id": "holiday-video",
          "name": "投影播放",
          "time": "10:00:00.000",
          "enabled": false,
          "defaultTarget": "VIDEO",
          "actions": [
            {
              "id": "holiday-a2",
              "type": "udp",
              "targets": [
                "VIDEO"
              ],
              "format": "ascii",
              "payload": "PLAY",
              "offsetMs": 250
            }
          ]
        },
        {
          "id": "holiday-audio",
          "name": "音响播放",
          "time": "10:00:00.000",
          "enabled": false,
          "defaultTarget": "AUDIO",
          "actions": [
            {
              "id": "holiday-a3",
              "type": "udp",
              "targets": [
                "AUDIO"
              ],
              "format": "ascii",
              "payload": "BGM ON"
            }
          ]
        },
        {
          "id": "holiday-all",
          "name": "闭馆联动",
          "time": "18:00:00.000",
          "enabled": false,
          "actions": [
            {
              "id": "holiday-a4",
              "type": "command",
